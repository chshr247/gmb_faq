# Значения вводятся в Vercel → Settings → Environment Variables.
# Этот файл - только список имён. Реальные ключи в репозиторий не попадают.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=   # Supabase → Project Settings → API keys → service_role (секретный!)
TELEGRAM_BOT_TOKEN=     # от @BotFather
TELEGRAM_CHAT_ID=       # от @userinfobot
IP_SALT=                # любая длинная случайная строка, придумай сам
STEAM_API_KEY=         # https://steamcommunity.com/dev/apikey - без него выдуманные SteamID не отсекаются

# Вход через Discord: discord.com/developers/applications → New Application → OAuth2.
# Там же в Redirects добавить https://<домен>/api/discord (для каждого домена сайта).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=  # OAuth2 → Client Secret → Reset Secret (секретный!)
SESSION_SECRET=         # любая длинная случайная строка; сменишь - разлогинит всех
