# Значения вводятся в Vercel → Settings → Environment Variables.
# Этот файл - только список имён. Реальные ключи в репозиторий не попадают.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=   # Supabase → Project Settings → API keys → service_role (секретный!)
TELEGRAM_BOT_TOKEN=     # от @BotFather
TELEGRAM_CHAT_ID=       # от @userinfobot
IP_SALT=                # любая длинная случайная строка, придумай сам
