# Значения вводятся в Vercel → Settings → Environment Variables.
# Этот файл - только список имён. Реальные ключи в репозиторий не попадают.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=    # Supabase → Project Settings → API keys → service_role (секретный!)
TELEGRAM_BOT_TOKEN=      # от @BotFather (секретный!)
TELEGRAM_CHAT_ID=        # твой id, от @userinfobot - сюда приходят заявки
ADMIN_IDS=               # кто админ в боте: id через запятую; пусто - только TELEGRAM_CHAT_ID
TELEGRAM_WEBHOOK_SECRET= # любая строка из A-Z a-z 0-9 _ - (до 256); та же - в setWebhook, см. README
STEAM_API_KEY=           # https://steamcommunity.com/dev/apikey - без него выдуманные SteamID не отсекаются
PANEL_URL=               # https://<домен>/admin.html - кнопка «Открыть панель» в боте; пусто - кнопки нет
